# Local-only personal application. Paths may contain spaces or Chinese characters.
WORLD_INSIGHT_PORT=8766
# Empty selects ~/Library/Application Support/World Insight; first initialization is explicit.
WORLD_INSIGHT_DATA_DIR=
WORLD_INSIGHT_BACKUP_DIR=
WORLD_INSIGHT_OPEN_BROWSER=1
# Paid and AI capabilities are reserved and remain disabled in P0.
WORLD_INSIGHT_AI_ENABLED=0
WORLD_INSIGHT_PAID_ENABLED=0
