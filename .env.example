# Personal, loopback-only application. Do not put secrets in tracked files.
WORLD_INSIGHT_PORT=8766
# Empty selects ~/Library/Application Support/World Insight. First creation requires --init.
# For existing research, set its original absolute data directory before starting.
WORLD_INSIGHT_DATA_DIR=
# Empty selects a sibling directory named World Insight Backups.
WORLD_INSIGHT_BACKUP_DIR=
WORLD_INSIGHT_OPEN_BROWSER=1
# Reserved interfaces remain disabled in P0 even if these are changed.
WORLD_INSIGHT_AI_ENABLED=0
WORLD_INSIGHT_PAID_ENABLED=0
# Interpreter override is a shell variable, for example:
# export WORLD_INSIGHT_PYTHON=/Library/Frameworks/Python.framework/Versions/3.11/bin/python3.11
